{
  "name": "agenv-cli",
  "version": "3.0.0",
  "description": "Portable AI workspace control plane for software repositories — one manifest for Codex, Copilot, Claude, Cursor, Windsurf, and MCP.",
  "keywords": [
    "ai",
    "cli",
    "developer-tools",
    "software-development",
    "mcp",
    "codex",
    "copilot",
    "claude",
    "cursor",
    "windsurf",
    "workspace",
    "web-app",
    "api-service",
    "frontend",
    "internal-tools",
    "agents-md",
    "claude-code",
    "ai-rules",
    "ai-config"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelyoo/agenv.git"
  },
  "homepage": "https://samuelyoo.github.io/agenv/",
  "bugs": {
    "url": "https://github.com/samuelyoo/agenv/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "agenv": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build && npm audit --audit-level=high",
    "prepublishOnly": "npm run verify",
    "start": "node dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.1",
    "commander": "^14.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
